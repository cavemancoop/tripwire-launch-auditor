# Copy to .env and fill in. Grouped by the milestone that first needs each value.
# Never commit .env. Never hardcode any of these in source.

# ── M0 / M1: local infra ────────────────────────────────────────────────
DATABASE_URL="postgresql://launch_auditor:launch_auditor@localhost:5432/launch_auditor?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# ── M1: chain access (Robinhood Chain, id 4663) ─────────────────────────
CHAIN_ID=4663
# RPC comparison (2026-09-06, empirical). None of the free ones is ideal for a
# sustained backfill; a keyed / dedicated node is the production answer.
#   rpc-robinhood.blockmachine.io   archive OK; clean 10k getLogs cap; ~12-req burst then "rate limit exceeded" (retryable)  <- current pick
#   rpc.ordofi.network              600/min nominal but -32005 "network is busy" flaps; archive BROKEN ("missing trie node" at depth)
#   rpc.mainnet.chain.robinhood.com official; small queries OK; hard-throttles "Too Many Requests"; fine as a live-watcher secondary
#   robinhood.api.pocket.network    non-archive (full node) — recent queries only
#   robinhood-rpc.publicnode.com    every getLogs = "Archive requires a personal token"
RH_RPC_URL="https://rpc-robinhood.blockmachine.io"
RH_RPC_ARCHIVE_URL="https://rpc-robinhood.blockmachine.io"  # archive-capable (backfill §7 + outcome eth_call at old blocks); may equal RH_RPC_URL
RPC_BUDGET_RPM=90                        # keep under blockmachine's burst limit; raise for a keyed/dedicated node
# NOT reachable server-side (Cloudflare 403). Human-readable evidence URLs only;
# never fetched at runtime. See DECISIONS.md (post-M3 checkpoint).
BLOCKSCOUT_API_BASE="https://robinhoodchain.blockscout.com/api/v2"
WATCHER_POLL_INTERVAL_MS=2000
WATCHER_HEAD_LAG_BLOCKS=60      # read blocks this far behind head (reorg + load-balanced-RPC lag)
WATCHER_MAX_SPAN_BLOCKS=4000    # max blocks ingested per poll; chunks a big catch-up

# ── M2: external scanners + qualified lane ────────────────────────────
GOPLUS_API_KEY=""                        # optional; raises rate limits. token_security/4663 works without it
SCANHOOD_API_BASE="https://scanhood.xyz" # no key; ~5 req/s per IP
QUALIFY_UNIQUE_BUYERS=25                 # spec §3.1/§12: buyers in 10m to run feature 9

# ── M3: signing + commitment ──────────────────────────────────────────
AGENT_EIP712_PRIVATE_KEY=""   # signs reports (EIP-712)
GAS_WALLET_PRIVATE_KEY=""     # posts Merkle roots on chain 4663
COMMIT_REGISTRY_ADDRESS=""    # set after `forge script` deploy
COMMIT_INTERVAL_SEC=300
COMMIT_MAX_LEAVES=200

# ── M4: outcome resolution + scorer + backfill ───────────────────────
RPC_BUDGET_RPM=500           # global token-bucket cap shared by every RPC caller
RPC_MAX_GETLOGS_RANGE=0      # 0 = probe the RPC's real limit on boot, then cache it
BACKFILL_DAYS=14             # spec §7 window (was 45; 14 clears the 200-resolved minimum)
BACKFILL_MAX_CALLS=0         # 0 = uncapped; set to enforce a hard RPC budget per run

# ── M5: Metabolism (Orbio MCP) ───────────────────────────────────────
ORBIO_MCP_URL="https://www.orbio.so/api/mcp"   # Streamable-HTTP MCP endpoint
METABOLISM_HYGIENE_ROTATE_DAYS=7               # key age ≥ this → hygiene ROTATING
METABOLISM_STATUS_POLL_SEC=60                  # lifecycle runner poll cadence (spec §8)
# RESERVE_USD replaces METABOLISM_RESERVE_R / _CLAIM_SIZE_USD (2026-09-09 decision:
# a key holds nothing, the account balance IS the quota, so there is nothing to
# "claim" and no claim size). Budget 3rd term becomes balance.usd - RESERVE_USD.
RESERVE_USD=3                                  # hard floor; balance − this ≤ 0 → STARVED
METABOLISM_LOW_WATER_USD=""                    # balance below this (but above reserve) → DRAINING. blank = 2 × RESERVE_USD
METABOLISM_IDS_TOLERANCE_USD=0.01             # IDS rounding tolerance (local MetabolismSpend Σ vs orbio_get_balance.spent, per-key baseline)
METABOLISM_IDS_GRACE_USD=""                   # IDS settlement grace; blank = DEEPDIVE_CAP_PER_RUN_USD + 0.05 (absorbs one in-flight deep-dive)
TOKEN_ENCRYPTION_KEY=""       # 32-byte base64 (openssl rand -base64 32); encrypts the persisted Orbio OAuth token at rest. `pnpm orbio:auth` prints one if unset.
ORBIO_OAUTH_CALLBACK_PORT=8976 # localhost port the one-time `pnpm orbio:auth` browser redirect lands on
ORBIO_TOKEN_STORE=""          # optional; path to the encrypted token store. Default: <repo-root>/.orbio/token-store.enc.json (gitignored)

# ── M6: LLM deep-dive (OpenRouter) ───────────────────────────────────
ORBIO_API_KEY=""              # gateway key minted by orbio_create_key (secret shown once). `pnpm orbio:probe` writes it here.
OPENROUTER_API_KEY=""         # supplied by Metabolism at runtime; set for local dev only
OPENROUTER_HTTP_REFERER=""    # attribution: your dashboard URL
OPENROUTER_X_TITLE="Launch Auditor"
OPENROUTER_MODEL_DEEPDIVE=""  # pinned exact slug, chosen in M6 (no ~latest / openrouter/auto)
DEEPDIVE_CAP_PER_RUN_USD=0.20
DEEPDIVE_DAILY_CAP_USD=5

# ── M7: payments ─────────────────────────────────────────────────────
REVENUE_ADDRESS=""            # plain address that receives USDG (no private key on server)
X402_FACILITATOR="canopy"     # canopy | solvador
PRICE_DEEPDIVE_USDG=0.10
DESIGN_PARTNER_API_KEYS=""    # comma-separated, bypass x402
# Revenue split: 2% of gross USDG -> ZachXBT as a periodic MANUAL transfer from
# REVENUE_ADDRESS, logged publicly. No splitter contract (spec §0.1 — minimise the
# money-handling surface; this supersedes the earlier M7 contract plan). DECISIONS.md.
SPLIT_ZACHXBT_BPS=200         # 2.00% — drives the manual-transfer accounting
SPLIT_ZACHXBT_ADDRESS="0x6eA158145907a1fAc74016087611913A96d96624"  # his public donation address

# ── M8: free feed ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
